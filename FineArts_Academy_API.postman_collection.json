    {
      "name": "8. Payments (QR Flow)",
      "item": [
        {
          "name": "Get QR Code + Amount for Class (Public)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/payments/qr/1"
          }
        },
        {
          "name": "Get Platform QR Settings (Public)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/payments/qr-settings"
          }
        },
        {
          "name": "Submit Payment (User - after scanning QR)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{firebase_token}}" }
            ],
            "url": "{{base_url}}/payments/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class_id\": 1,\n  \"booking_type\": \"CLASS\",\n  \"amount\": 1500,\n  \"utr_number\": \"UTR123456789\",\n  \"payment_screenshot\": \"https://example.com/screenshot.jpg\",\n  \"start_date\": \"2026-06-01\",\n  \"end_date\": \"2026-08-31\",\n  \"coupon_id\": null,\n  \"discount_amount\": 0,\n  \"points_redeemed\": 0,\n  \"points_discount\": 0\n}"
            }
          }
        },
        {
          "name": "Submit Payment WITH Coupon",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{firebase_token}}" }
            ],
            "url": "{{base_url}}/payments/submit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class_id\": 1,\n  \"booking_type\": \"CLASS\",\n  \"amount\": 1500,\n  \"utr_number\": \"UTR987654321\",\n  \"coupon_id\": 1,\n  \"discount_amount\": 150,\n  \"points_redeemed\": 50,\n  \"points_discount\": 5\n}"
            }
          }
        },
        {
          "name": "Get My Payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{firebase_token}}" }],
            "url": "{{base_url}}/payments/my"
          }
        },
        {
          "name": "Get Pending Payments (Admin/Institute)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{institute_token}}" }],
            "url": "{{base_url}}/payments/pending"
          }
        },
        {
          "name": "Verify Payment (Admin/Institute)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/payments/1/verify"
          }
        },
        {
          "name": "Reject Payment (Admin/Institute)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/payments/1/reject",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"UTR number not found in bank records\"\n}"
            }
          }
        }
      ]
    },
