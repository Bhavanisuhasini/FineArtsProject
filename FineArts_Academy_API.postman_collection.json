{
  "info": {
    "name": "FineArts Academy API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API collection for FineArts Academy backend"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api" },
    { "key": "firebase_token", "value": "PASTE_FIREBASE_ID_TOKEN_HERE" },
    { "key": "admin_token", "value": "PASTE_ADMIN_JWT_TOKEN_HERE" },
    { "key": "trainer_token", "value": "PASTE_TRAINER_FIREBASE_TOKEN_HERE" },
    { "key": "institute_token", "value": "PASTE_INSTITUTE_FIREBASE_TOKEN_HERE" }
  ],
  "item": [

    {
      "name": "1. Admin Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin-auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@finearts.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Auth (Firebase Users)",
      "item": [
        {
          "name": "Login / Register (User)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{firebase_token}}" }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"USER\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{firebase_token}}" }],
            "url": "{{base_url}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "3. User Profile",
      "item": [
        {
          "name": "Create / Update Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{firebase_token}}" }
            ],
            "url": "{{base_url}}/users/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Arjun Kumar\",\n  \"gender\": \"MALE\",\n  \"date_of_birth\": \"2000-05-15\",\n  \"city\": \"Chennai\",\n  \"state\": \"Tamil Nadu\",\n  \"country\": \"India\",\n  \"pincode\": \"600001\"\n}"
            }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{firebase_token}}" }],
            "url": "{{base_url}}/users/profile"
          }
        }
      ]
    },

